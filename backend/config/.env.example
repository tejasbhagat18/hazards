# SIH 2026 - Earth Engine Configuration
# All free. Leave blank until Phase 5 (live data).

# Earth Engine Project (register yours at code.earthengine.google.com)
GEE_PROJECT=                # registered Earth Engine project (e.g. <your-project>)
GEE_CREDENTIALS=             # path to service account JSON (optional, for server-side)

# Hazard source assets (flood/landslide). Set to the Earth Engine image ids you
# export or subscribe to; no hard-coded defaults are shipped.
GEE_ASSET_FLOOD_GFSM=       # flood susceptibility ImageCollection id
GEE_ASSET_LANDSLIDE_ILSM=   # landslide probability Image id

# Pipeline Options
USE_GEE=false                # set to true to use GEE pipeline in run_pipeline.py
SIH_DISTRICT=chamoli         # active district: chamoli, kendrapara
GEE_ASSET_PREFIX=            # e.g. projects/<your-project>/assets/sih

# Optional Data Sources
CDS_URL=
CDS_KEY=
MOSDAC_TOKEN=
NASA_EARTHDATA_USER=
NASA_EARTHDATA_PASS=
INCOIS_ACCESS=